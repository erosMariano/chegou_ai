# --- Database (PostgreSQL) ---
POSTGRES_USER=chegou_admin
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=chegou_ai
DATABASE_URL=postgresql://chegou_admin:postgres_dev_password@localhost:5432/chegou_ai

# --- Cache & Locks (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Message Broker (RabbitMQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Inteligência Artificial (Visão Computacional) ---
GEMINI_API_KEY=sua_chave_api_gemini_aqui
AI_MODEL_VISION=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.80
AI_TIMEOUT_MS=4000

# --- Web Push Notifications (VAPID Keys) ---
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui
VAPID_PRIVATE_KEY=sua_chave_privada_vapid_aqui
VAPID_SUBJECT=mailto:contato@chegou.ai

# --- Auth & URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORE_API_URL=http://localhost:8080
JWT_SECRET="sua_chave_secreta_aleatoria_com_no_minimo_32_caracteres_aqui"